#!/bin/sh /etc/rc.common
# haku-wrt: put the WAN switch ports on gmac1 and the others on gmac0 (see
# /usr/sbin/haku-conduit). Runs before the network comes up and again whenever
# the network or firewall config changes; disable it to keep all ports on gmac0.

START=19
USE_PROCD=1

start_service() {
	/usr/sbin/haku-conduit
}

reload_service() {
	/usr/sbin/haku-conduit
}

service_triggers() {
	procd_add_reload_trigger "network" "firewall"
}
