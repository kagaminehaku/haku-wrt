#!/bin/sh

. /lib/functions.sh

# haku-wrt: only set these defaults on a fresh install. A firmware update
# restores /etc/config/wireless (and this marker) and must not overwrite them.
marker="/etc/haku/wireless-defaults"
[ -f "${marker}" ] && exit 0

customized="0"
check_iface() {
    local ssid encryption
    config_get ssid "${1}" ssid
    config_get encryption "${1}" encryption "none"
    case "${ssid}" in
    OpenWrt | ImmortalWrt | "") ;;
    *) customized="1" ;;
    esac
    [ "${encryption}" = "none" ] || customized="1"
}

# =======================================================
# 1. Configure wireless settings
# =======================================================
if [ ! -f /etc/config/wireless ]; then
    wifi config
fi

config_load wireless
config_foreach check_iface wifi-iface
if [ "${customized}" = "1" ]; then
    mkdir -p "${marker%/*}" && touch "${marker}"
    exit 0
fi

# The radios start disabled with a random WPA2/WPA3 key, so a fresh install
# never broadcasts an open network; enable them in LuCI, where the key can be
# read or changed.
key="$(hexdump -n 6 -e '6/1 "%02x"' /dev/urandom)"

# -----------------------------------------------------------
# 2. Configure 2G (radio0) - HE20 (AX mode)
# -----------------------------------------------------------
# Check if radio0 exists to avoid errors
if uci get wireless.radio0 >/dev/null 2>&1; then
    uci set wireless.radio0.disabled='1'
    uci set wireless.radio0.country='VN'
    uci set wireless.radio0.band='2g'
    uci set wireless.radio0.channel='6'
    uci set wireless.radio0.htmode='HE20'
    uci set wireless.radio0.cell_density='0'
    uci set wireless.radio0.legacy_rates='0'

    # Interface settings
    uci set wireless.default_radio0.device='radio0'
    uci set wireless.default_radio0.network='lan'
    uci set wireless.default_radio0.mode='ap'
    uci set wireless.default_radio0.ssid='OpenWrt'
    uci set wireless.default_radio0.encryption='sae-mixed'
    uci set wireless.default_radio0.key="${key}"
fi

# -----------------------------------------------------------
# 3. Configure 5G (radio1) - HE80 (AX mode)
# -----------------------------------------------------------
# Check if radio1 exists to avoid errors
if uci get wireless.radio1 >/dev/null 2>&1; then
    uci set wireless.radio1.disabled='1'
    uci set wireless.radio1.country='VN'
    uci set wireless.radio1.band='5g'
    uci set wireless.radio1.channel='149'
    uci set wireless.radio1.htmode='HE80'
    uci set wireless.radio1.cell_density='1'
    uci set wireless.radio1.legacy_rates='0'

    # Interface settings
    uci set wireless.default_radio1.device='radio1'
    uci set wireless.default_radio1.network='lan'
    uci set wireless.default_radio1.mode='ap'
    uci set wireless.default_radio1.ssid='OpenWrt'
    uci set wireless.default_radio1.encryption='sae-mixed'
    uci set wireless.default_radio1.key="${key}"
fi

# -----------------------------------------------------------
# 4. Apply changes
# -----------------------------------------------------------
uci commit wireless
wifi reload

mkdir -p "${marker%/*}" && touch "${marker}"

exit 0
